{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"slug": "pearl",
					"name": "Pearl",
					"color": "#FBFBF9"
				},
				{
					"slug": "blush",
					"name": "Blush",
					"color": "#F2E6D8"
				},
				{
					"slug": "cream",
					"name": "Cream",
					"color": "#F7F0E8"
				},
				{
					"slug": "dune",
					"name": "Dune",
					"color": "#E5CDB5"
				},
				{
					"slug": "terra",
					"name": "Terra",
					"color": "#D9B595"
				},
				{
					"slug": "clay",
					"name": "Clay",
					"color": "#A69486"
				},
				{
					"slug": "earth",
					"name": "Earth",
					"color": "#422921"
				},
				{
					"slug": "white",
					"name": "White",
					"color": "#FFFFFF"
				},
				{
					"slug": "clay-text",
					"name": "Clay — text (accessible)",
					"color": "#665548"
				},
				{
					"slug": "terra-text",
					"name": "Terra — text (accessible)",
					"color": "#7D5F44"
				}
			],
			"gradients": [],
			"duotone": [
				{
					"slug": "earth-pearl",
					"name": "Earth and Pearl",
					"colors": [
						"#422921",
						"#FBFBF9"
					]
				},
				{
					"slug": "clay-blush",
					"name": "Clay and Blush",
					"colors": [
						"#665548",
						"#F2E6D8"
					]
				}
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"slug": "soft",
					"name": "Soft",
					"shadow": "0 1px 2px rgba(66, 41, 33, 0.04), 0 10px 30px rgba(66, 41, 33, 0.06)"
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"em",
				"%",
				"vh",
				"vw"
			],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"slug": "10",
					"name": "XXS",
					"size": "0.5rem"
				},
				{
					"slug": "20",
					"name": "XS",
					"size": "clamp(0.75rem, 1.5vw, 1rem)"
				},
				{
					"slug": "30",
					"name": "S",
					"size": "clamp(1rem, 2vw, 1.5rem)"
				},
				{
					"slug": "40",
					"name": "M",
					"size": "clamp(1.5rem, 3vw, 2rem)"
				},
				{
					"slug": "50",
					"name": "L",
					"size": "clamp(2rem, 4.5vw, 3.25rem)"
				},
				{
					"slug": "60",
					"name": "XL",
					"size": "clamp(2.75rem, 6.5vw, 5rem)"
				},
				{
					"slug": "70",
					"name": "XXL",
					"size": "clamp(3.5rem, 9vw, 7.5rem)"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"writingMode": true,
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.8125rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1rem",
					"fluid": {
						"min": "0.9375rem",
						"max": "1rem"
					}
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.25rem",
					"fluid": {
						"min": "1.125rem",
						"max": "1.25rem"
					}
				},
				{
					"slug": "x-large",
					"name": "Extra Large",
					"size": "1.875rem",
					"fluid": {
						"min": "1.5rem",
						"max": "1.875rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "2X Large",
					"size": "2.75rem",
					"fluid": {
						"min": "2rem",
						"max": "2.75rem"
					}
				},
				{
					"slug": "display",
					"name": "Display",
					"size": "4rem",
					"fluid": {
						"min": "2.5rem",
						"max": "4rem"
					}
				}
			],
			"fontFamilies": [
				{
					"name": "Marcellus (headings)",
					"slug": "heading",
					"fontFamily": "Marcellus, 'Times New Roman', serif",
					"fontFace": [
						{
							"fontFamily": "Marcellus",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/marcellus-latin-400-normal.woff2"
							]
						}
					]
				},
				{
					"name": "Poppins (subheadings & body)",
					"slug": "body",
					"fontFamily": "Poppins, 'Helvetica Neue', Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Poppins",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/poppins-latin-400-normal.woff2"
							]
						},
						{
							"fontFamily": "Poppins",
							"fontStyle": "italic",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/poppins-latin-400-italic.woff2"
							]
						},
						{
							"fontFamily": "Poppins",
							"fontStyle": "normal",
							"fontWeight": "500",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/poppins-latin-500-normal.woff2"
							]
						},
						{
							"fontFamily": "Poppins",
							"fontStyle": "italic",
							"fontWeight": "500",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/poppins-latin-500-italic.woff2"
							]
						},
						{
							"fontFamily": "Poppins",
							"fontStyle": "normal",
							"fontWeight": "600",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/poppins-latin-600-normal.woff2"
							]
						},
						{
							"fontFamily": "Poppins",
							"fontStyle": "italic",
							"fontWeight": "600",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/poppins-latin-600-italic.woff2"
							]
						}
					]
				},
				{
					"name": "Cormorant Garamond Italic (accent)",
					"slug": "accent",
					"fontFamily": "'Cormorant Garamond', Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Cormorant Garamond",
							"fontStyle": "italic",
							"fontWeight": "300 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/cormorant-garamond-latin-wght-italic.woff2"
							]
						}
					]
				}
			]
		},
		"custom": {
			"radius": {
				"none": "0",
				"small": "2px",
				"medium": "4px",
				"large": "8px",
				"pill": "999px"
			},
			"line-height": {
				"tight": "1.15",
				"snug": "1.3",
				"body": "1.75"
			}
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": true
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--pearl)",
			"text": "var(--wp--preset--color--earth)"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"top": "0px",
				"right": "var(--wp--preset--spacing--40)",
				"bottom": "0px",
				"left": "var(--wp--preset--spacing--40)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontWeight": "400",
			"lineHeight": "var(--wp--custom--line-height--body)"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--earth)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "400",
					"lineHeight": "var(--wp--custom--line-height--tight)",
					"letterSpacing": "0"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--display)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"lineHeight": "var(--wp--custom--line-height--snug)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"lineHeight": "var(--wp--custom--line-height--snug)"
				}
			},
			"h5": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "500",
					"letterSpacing": "0.08em",
					"textTransform": "uppercase",
					"lineHeight": "var(--wp--custom--line-height--snug)"
				}
			},
			"h6": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "500",
					"letterSpacing": "0.1em",
					"textTransform": "uppercase"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--earth)"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--clay-text)"
					},
					"typography": {
						"textDecoration": "none"
					}
				},
				":focus": {
					"outline": {
						"color": "var(--wp--preset--color--earth)",
						"offset": "3px",
						"style": "solid",
						"width": "2px"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--terra)",
					"text": "var(--wp--preset--color--earth)"
				},
				"border": {
					"radius": "var(--wp--custom--radius--none)",
					"width": "0"
				},
				"spacing": {
					"padding": {
						"top": "0.95rem",
						"right": "2rem",
						"bottom": "0.95rem",
						"left": "2rem"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "0.875rem",
					"fontWeight": "500",
					"lineHeight": "1.2",
					"letterSpacing": "0.08em",
					"textTransform": "uppercase"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--earth)",
						"text": "var(--wp--preset--color--pearl)"
					}
				},
				":focus": {
					"outline": {
						"color": "var(--wp--preset--color--earth)",
						"offset": "3px",
						"style": "solid",
						"width": "2px"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--clay-text)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "1.5rem",
					"fontWeight": "400",
					"letterSpacing": "0.06em",
					"textTransform": "uppercase",
					"lineHeight": "1"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--clay-text)"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/site-tagline": {
				"color": {
					"text": "var(--wp--preset--color--clay-text)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "0.8125rem",
					"fontWeight": "500",
					"letterSpacing": "0.08em",
					"textTransform": "uppercase"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"typography": {
								"textDecoration": "underline"
							}
						}
					}
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--earth)"
						},
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"color": {
								"text": "var(--wp--preset--color--clay-text)"
							}
						}
					}
				}
			},
			"core/post-date": {
				"color": {
					"text": "var(--wp--preset--color--clay-text)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/post-terms": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "500"
				}
			},
			"core/post-featured-image": {
				"border": {
					"radius": "var(--wp--custom--radius--none)"
				}
			},
			"core/image": {
				"border": {
					"radius": "var(--wp--custom--radius--none)"
				}
			},
			"core/cover": {
				"border": {
					"radius": "0"
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var(--wp--preset--color--terra)",
						"style": "solid",
						"width": "2px"
					}
				},
				"spacing": {
					"padding": {
						"left": "var(--wp--preset--spacing--30)"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--accent)",
					"fontSize": "1.625rem",
					"fontStyle": "italic",
					"fontWeight": "400",
					"lineHeight": "1.35"
				},
				"elements": {
					"cite": {
						"typography": {
							"fontFamily": "var(--wp--preset--font-family--body)",
							"fontSize": "var(--wp--preset--font-size--small)",
							"fontStyle": "normal",
							"fontWeight": "500",
							"letterSpacing": "0.08em",
							"textTransform": "uppercase"
						}
					}
				}
			},
			"core/pullquote": {
				"border": {
					"width": "0"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--accent)",
					"fontSize": "2rem",
					"fontStyle": "italic",
					"fontWeight": "400",
					"lineHeight": "1.3"
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--dune)"
				},
				"border": {
					"width": "1px"
				}
			},
			"core/details": {
				"border": {
					"bottom": {
						"color": "var(--wp--preset--color--dune)",
						"style": "solid",
						"width": "1px"
					}
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--20)",
						"bottom": "var(--wp--preset--spacing--20)"
					}
				}
			},
			"core/search": {
				"border": {
					"radius": "var(--wp--custom--radius--none)"
				},
				"typography": {
					"fontSize": "1rem"
				}
			},
			"core/table": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/code": {
				"color": {
					"background": "var(--wp--preset--color--cream)"
				},
				"border": {
					"radius": "var(--wp--custom--radius--small)"
				},
				"typography": {
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
					"fontSize": "0.9rem"
				}
			},
			"core/query-pagination": {
				"typography": {
					"fontWeight": "600"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		},
		{
			"name": "announcement",
			"title": "Announcement Bar",
			"area": "uncategorized"
		}
	],
	"customTemplates": [
		{
			"name": "page-landing",
			"title": "Landing Page (no title, full width)",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-sidebar-cta",
			"title": "Page with Booking Sidebar",
			"postTypes": [
				"page"
			]
		}
	]
}
